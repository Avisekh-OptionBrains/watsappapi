{
  "name": "watsappapi-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "OptionBrains WhatsApp automation gateway (Meta Cloud API + Typebot)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "bootstrap": "tsx scripts/bootstrap-instance.ts",
    "test": "tsx --test src/lib/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^6.0.1",
    "ioredis": "^5.4.2",
    "nanoid": "^3.3.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
