# =============================================================================
# WhatsApp Automation Service — OptionBrains
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Postgres (shared by Evolution + Typebot schemas) ---
POSTGRES_USER=watsapp
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=watsapp
# External Postgres for Typebot. When this is set, production does not start a Postgres container.
# Example: postgresql://user:password@host:25060/defaultdb?schema=typebot&sslmode=require
# TYPEBOT_DATABASE_URL=

# --- Redis ---
REDIS_PASSWORD=change_me_redis_password

# --- Evolution API (optional compatibility profile; not in production delivery path) ---
EVOLUTION_ENABLED=0
AUTHENTICATION_API_KEY=change_me_evolution_global_api_key
SERVER_URL=http://localhost:8080
# After starting Cloudflare tunnel, set SERVER_URL to the https://….trycloudflare.com URL:
#   .\scripts\cloudflare-tunnel.ps1 -ApplyServerUrl
# Meta webhook callback: ${SERVER_URL}/webhook/meta
# Meta Cloud webhook verify token (Evolution forwards Meta callbacks)
WA_BUSINESS_TOKEN_WEBHOOK=replace-with-long-random-verify-token
WA_BUSINESS_VERSION=v21.0

# Global webhook → gateway (use service name inside Docker network)
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=http://gateway:3100/webhooks/evolution
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_MESSAGES_UPDATE=true
WEBHOOK_EVENTS_SEND_MESSAGE=true
WEBHOOK_EVENTS_SEND_MESSAGE_UPDATE=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_TYPEBOT_START=true
WEBHOOK_EVENTS_TYPEBOT_CHANGE_STATUS=true

TYPEBOT_ENABLED=true
TYPEBOT_API_VERSION=latest
TYPEBOT_PUBLIC_ID=ob-support
TYPEBOT_BRIDGE_ENABLED=1
# Product chatbot (plans / sign-in menus). Keep 0 until go-live — OTP templates still work.
WHATSAPP_PRODUCT_BOT_ENABLED=0

# --- Meta WhatsApp Cloud (same credentials as ob-research) ---
WHATSAPP_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_TEMPLATE_NAME=otp_code
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_INCLUDE_OTP_BUTTON=1
WHATSAPP_GRAPH_VERSION=v21.0
# Meta App Dashboard → App settings → Basic → App secret (validates webhook signatures)
WHATSAPP_APP_SECRET=your-meta-app-secret

# Evolution instance name for Cloud API
EVOLUTION_INSTANCE_NAME=optionbrains

# --- Gateway (what ob-research calls) ---
GATEWAY_PORT=3100
SERVICE_API_KEY=change_me_long_random_service_key
WEBHOOK_SHARED_SECRET=change_me_webhook_shared_secret
# Host-side URL (bootstrap / local gateway). Docker gateway ignores this and uses evolution-api:8080
EVOLUTION_API_URL=http://localhost:8080
# Host Redis mapped port is 6380; Docker gateway uses redis:6379 via compose
REDIS_URL=redis://:change_me_redis_password@127.0.0.1:6380/0
# Campaign pacing (ms between sends)
CAMPAIGN_SEND_DELAY_MS=1200
CAMPAIGN_REQUIRE_OPT_IN=1
CAMPAIGN_MAX_RECIPIENTS=5000
# Customer messages, STOP, and START are posted here and written onto the client CRM.
# From Docker use host.docker.internal so this reaches the site on the host, not another app on port 3000 inside a container.
OB_RESEARCH_WEBHOOK_URL=http://host.docker.internal:3000/api/whatsapp/gateway
OB_RESEARCH_WEBHOOK_SECRET=change_me_same_as_WATSAPP_WEBHOOK_SECRET
# OB_RESEARCH_API_URL=http://host.docker.internal:3000
# OB_RESEARCH_BOT_KEY=
# Public site for customer CTAs (avoid localhost in WhatsApp)
# WHATSAPP_PUBLIC_SITE_URL=https://optionbrains.com


# --- Typebot ---
TYPEBOT_ENCRYPTION_SECRET=change_me_32_char_encryption_secret!!
TYPEBOT_ADMIN_EMAIL=admin@optionbrains.com
NEXTAUTH_URL=http://localhost:3001
# Browser / host URL for the public bot (you open this in Chrome)
NEXT_PUBLIC_VIEWER_URL=http://localhost:3002
# Evolution (inside Docker) must call the viewer by service name — set when registering bots:
# TYPEBOT_EVOLUTION_URL=http://typebot-viewer:3000
TYPEBOT_EVOLUTION_URL=http://typebot-viewer:3000
# Email sign-in for the Typebot builder. SMTP_USERNAME is the mailbox login.
SMTP_AUTH_DISABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@optionbrains.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=OptionBrains <noreply@optionbrains.com>
DISABLE_SIGNUP=false

# --- Production HTTPS (docker-compose.prod.yml). Caddy is the only public port. ---
# WA_HOST=wa.optionbrains.com
# TYPEBOT_HOST=typebot.optionbrains.com
# VIEWER_HOST=bot.optionbrains.com
# ACME_EMAIL=admin@optionbrains.com
# NEXTAUTH_URL=https://typebot.optionbrains.com
# NEXT_PUBLIC_VIEWER_URL=https://bot.optionbrains.com
# OB_RESEARCH_API_URL=https://optionbrains.com
# OB_RESEARCH_WEBHOOK_URL=https://optionbrains.com/api/whatsapp/gateway
# DISABLE_SIGNUP=true
