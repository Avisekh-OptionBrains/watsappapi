# Local secrets for `npm run dev`. Copy to .dev.vars (never commit it).
# In production set each of these with `npx wrangler secret put <NAME>`.

# Accept unsigned webhooks locally (production always requires WHATSAPP_APP_SECRET).
ENVIRONMENT=development

# Meta Cloud API (Business settings -> System users -> permanent token).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1242724822266426
# App dashboard -> App settings -> Basic -> App secret. Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Any random string; enter the same value in Meta -> WhatsApp -> Configuration -> Verify token.
WHATSAPP_VERIFY_TOKEN=

# Staff dashboard (/admin) and /v1/admin/*. Signs in as "Admin". Min 24 chars.
ADMIN_API_KEY=
# Optional named staff logins for the dashboard - one JSON array on a single line. Keys min 24 chars.
# role: "agent" (default) or "admin" (campaigns, quick-reply library, CSV export).
# STAFF='[{"name":"Neha","key":"<min 24 chars>","role":"agent"},{"name":"Arjun","key":"<min 24 chars>","role":"admin"}]'

# Optional: Gemini answers to free-text questions + AI drafts for staff (https://aistudio.google.com/apikey).
# GEMINI_API_KEY=

# Optional: alerts when a customer asks for a person (any combination).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=WhatsApp Inbox <alerts@optionbrains.com>
# ALERT_EMAIL_TO=support@optionbrains.com
# DASHBOARD_URL=http://localhost:8787

# Websites that use this gateway - one JSON array on a single line. See README "Sites".
SITES='[{"id":"optionbrains","name":"OptionBrains","tagline":"Research plans & model portfolios","apiKey":"<min 24 chars>","publicUrl":"https://optionbrains.com","webhook":{"url":"https://optionbrains.com/api/whatsapp/webhook","secret":"<min 16 chars>"},"bot":{"apiUrl":"https://optionbrains.com/api/whatsapp/bot","apiKey":"<min 16 chars>","connector":"optionbrains"}},{"id":"tradepod","name":"TradePod","tagline":"Managed trading desks","apiKey":"<min 24 chars>","publicUrl":"https://tradepod.in","bot":{"apiUrl":"https://tradepod.in/api/whatsapp/bot","apiKey":"<min 16 chars>"}}]'
